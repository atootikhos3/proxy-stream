{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "streamvault-api",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  "observability": {
    "enabled": true
  },
  // WASM bundling — with an ES module worker, wrangler compiles referenced
  // *.wasm imports into precompiled WebAssembly.Module objects and bundles
  // them into the deploy. src/index.js does `import MAKIMA_WASM from
  // "../makima.wasm"` and instantiates it per-request (fine — the compile
  // already happened at deploy time; only WebAssembly.instantiate(bytes) is
  // blocked at runtime).
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }
  ],
  // R2 bucket for HLS segment caching (AtootiStream Cache path). See
  // handleHlsProxy in src/index.js.
  "r2_buckets": [
    { "binding": "HLS_CACHE", "bucket_name": "atooti-hls-cache" }
  ],
  // Rolling-window eviction cron: every 5 min, drop objects older than
  // CACHE_TTL_MIN, then clamp total size below CACHE_MAX_BYTES.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "CACHE_TTL_MIN": "45",
    "CACHE_MAX_BYTES": "8589934592"
  }
}
